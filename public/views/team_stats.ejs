<!DOCTYPE html>

<html>
    <head>
        <title><%= teamStats.teamName %> Stats</title>
        <link rel="stylesheet" href="/styles/team_stats.css">
        <link href="https://jsdelivr.net" rel="stylesheet">
    </head>

    <body>

        <%- include ('menu_header') %>

        <div class="topSection">
            <div class="titleSection">
                <img class="mainLogo" src="<%= teamStats.teamLogo %>">
                <h1><%= teamStats.teamName %></h1>
                <div id="seasonDescDiv">
                    <h4>
                        Requested Season: <%= teamStats.requestedYearText %> <%= teamStats.requestedTypeText %>
                        <br>
                        Season Record: <%= teamStats.recordSummary %>
                        <br>
                        Standings: <%= teamStats.standingSummary %>
                    </h4>
                </div>
            </div>

            <div class="form-container">
                <form method="GET">

                    <div class="form-group">
                        <label for="season">Select a Season:</label>
                        <select name="season">
                            <% for (let i = teamStats.seasonYear; i >= 2000; i--){ %>
                                <option value="<%= i %>"><%= i %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="seasonType">Select Season Type:</label>
                        <select name="seasonType">
                            <option value="2">Regular Season</option>
                            <option value="3">Postseason</option>
                        </select>
                    </div>
                    <button>Submit</button>
                </form>
            </div>
        </div>

        <!--If no data is available for the requested team/season, show this message-->
        <% if (!teamStats){ %>

            <h1>This Data is Not Available Yet.</h1>
        
        <!--If team did not qualify for postseason, show this message-->
        <% } else if (
            (teamStats.requestedSeason < teamStats.seasonYear && teamStats.qualifiedPostSeason == false && teamStats.requestedType == 3)
            || (teamStats.requestedSeason == teamStats.seasonYear && teamStats.seasonType == 3 &&
                teamStats.requestedType == 3 && teamStats.qualifiedPostSeason == false)) { %>

            <h1>Team Did Not Make the Postseason for the Requested Season.</h1>

        <!--If user requests season data that has not occurred yet, show this message-->
        <% } else if (teamStats.requestedSeason == teamStats.seasonYear 
            && teamStats.requestedType > teamStats.seasonType){ %>

            <h1>Data Not Yet Available. The Requested Season Has Not Yet Occurred.</h1>

        <!--if everything checks out-->
        <% } else { %>

            <div id="statsSection"> <!--The main section for categories-->

                <div id="mainStatsDiv">
                    <% teamStats.categories.forEach(category => { %>

                        <h2 class="importantHeadline"><%= category.name %></h2>
                        <div class="tableDivide">
                            <table>
                                <tr>
                                    <% category.stats.forEach(stat => { %>
                                        <th>
                                            <div class="tooltip"><%= stat.abbreviation %>
                                                <span class="tooltip-text">
                                                    <u><%= stat.name %></u>
                                                    <br>
                                                    <%= stat.description %>
                                                </span>
                                            </div>
                                        </th>
                                    <% }) %>
                                </tr>
                                <tr>
                                    <% category.stats.forEach(stat => { %>
                                        <td><%= stat.value %></td>
                                    <% }) %>
                                </tr>
                            </table>
                        </div>
                    <% }) %>
                </div>


                <!--If baseball team, we can show extra, more advanced splits, and render this section-->
                <% if (league == "MLB"){ %>

                    <div id="splitsDiv">
                        
                        <% let counter = 0; %> <!--For having the select options match splits data-->

                        <div class="select-wrapper">
                            <select id="sortIndex">
                                <% teamStats.splits.forEach(split => { %>    
                                    <option value="<%= counter %>"><%= split.abbreviation %></option>
                                    <% counter++;
                                });
                                counter = 0; %>
                            </select>
                        </div>

                        <% teamStats.splits.forEach(split => { %>

                            <div id="<%= counter %>" class="filteredSection">

                                <h3>Stats for: <%= split.abbreviation %></h3>

                                <% split.categories.forEach(category => { %>

                                    <h2 class="importantHeadline"><%= category.name %></h2>

                                    <div class="tableDivide">
                                        <table>
                                            <tr>
                                                <% category.stats.forEach(stat => { %>
                                                    <th>
                                                        <div class="tooltip"><%= stat.abbreviation %>
                                                            <span class="tooltip-text">
                                                                <u><%= stat.name %></u>
                                                                <br>
                                                                <%= stat.description %>
                                                            </span>
                                                        </div>
                                                    </th>
                                                <% }) %>
                                            </tr>
                                            <tr>
                                                <% category.stats.forEach(stat => { %>
                                                    <td><%= stat.value %></td>
                                                <% }) %>
                                            </tr>
                                        </table>
                                    </div>
                                <% }) %>
                            </div>
                            <% counter++;
                        }) %>

                        <script>

                            //all the div elements 
                            const divs = document.querySelectorAll('.filteredSection');
                            divs.forEach(div => div.style.display = 'none');

                            //the select element
                            const filter = document.getElementById('sortIndex');

                            //change visibility of tables when a new option is selected
                            function selectDiv(){

                                const selectedIndex = filter.value;

                                divs.forEach(div => div.style.display = 'none');

                                const selectedDiv = document.getElementById(selectedIndex);
                                selectedDiv.style.display = 'block';
                            }

                            selectDiv();

                            filter.addEventListener('change', selectDiv);

                        </script>
                    </div>

                <% } %>
                
            </div>
        <% } %>
    </body>
</html>