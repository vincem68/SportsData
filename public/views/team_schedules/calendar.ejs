
<div id="scheduleDiv">

    <% data.months.forEach(month => { %>

        <h3 class="monthTitle"><%= month.monthName %></h3>
        <div class="monthDiv">

            <!--Loop through every calendar week of the month, make a div for each-->
            <% for (let week = 0; week < month.totalCalendarWeeks; week++) { %>

                <div class="weekDiv">

                    <!--Loop through the 7 days of each calendar week. Includes dead days-->
                    <% for (let day = 0; day < 7; day++) { %>

                        <!--Add in dead days of the start of the calendar if on first week-->
                        <% if (week == 0 && day < month.firstWeekDayOfMonth) { %>
                            <div class="deadDay"></div>
                            <% continue; %>
                        <% } %>

                        <!--Add in dead days of the end of the calendar if on last week-->
                        <% if (week === month.totalCalendarWeeks - 1 && day > month.lastWeekDayOfMonth) { %>
                            <div class="deadDay"></div>
                            <% continue; %>
                        <% } %>

                        <!--Get the numbered day of the month-->
                        <% const dayNum = week * 7 + (day - month.firstWeekDayOfMonth + 1); %>
                        <!--See if there's a game that exists with the day number of the month-->
                        <% const game = month.events.find(game => game.dayNum === dayNum); %>
                        <!--If a game exists with that numbered day in that month, make a div for it-->
                        <% if (game) { %>

                            <div class="gameDay <% if (game.home) { %> homeGame <% } else { %> roadGame <% } %>">

                                <h4 class="dayNum"><%= dayNum %></h4>
                                <img class="opponentLogo" src="<%= game.opponentLogo %>" alt="<%= game.opponentAbbr %> logo">
                                <p><%= game.opponentAbbr %></p>

                                <a href="http://localhost:<%= port %>/<%= sport %>/<%= league.toLowerCase() %>/games/<%= game.id %>">

                                    <% if (game.status == "pre"){ %> 
                                        <%= game.startTime %>
                                    <% } else if (game.status == "post") { %>
                                        <% if (game.winner) { %> W <% } else { %> L <% } %> <%= game.score %>
                                    <% } else { %>
                                        In Progress
                                    <% } %>
                                </a>
                            </div>

                            <!--Else, make an empty calendar day where it only has a number and nothing else-->
                        <% } else { %>
                            <div class="emptyDay">
                                <h4 class="dayNum"><%= dayNum %></h4>
                            </div>
                        <% } %>
                        
                    <% } %>
                </div>
            <% } %>

        </div>
    <% }) %>
</div>

<link rel="stylesheet" href="/styles/team_schedule_styles/calendar_styles.css">