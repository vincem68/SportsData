<% data.rounds.forEach(round => { %>

    <% if (round.games.length == 0){ %>

        <% if ((round.roundName.includes("Wild") || round.roundName.includes("First"))
             && round.games.length == 0){ %>

            <h2 class="seriesTitle"><%= round.roundName %></h2>
            <div class="seriesDiv">
                <h1>First Round Bye</h1>
            </div>

        <% } %>

    <% } else { %>
        
        <h2 class="seriesTitle"><%= round.roundName %></h2>
        <div class="seriesDiv">

            <div class="seriesOpponent">
                <img src="/images/versus_sign.png">
                <div>
                    <img src="<%= round.seriesOpponent.logo %>">
                    <h2><%= round.seriesOpponent.name %></h2>
                </div>
            </div>

            <% round.games.forEach(game => { %>

                <div id="<%= game.id %>" class="gameContainer 
                    <% if (game.home){ %> homeGame <% } else { %> roadGame <% } %>">

                    <div class="awayTeamDiv">
                        <img class="teamLogo" src="<% if (!game.home) { %> <%= data.team.logo %> <% } else { %> <%= round.seriesOpponent.logo %> <% } %>">
                        <p><% if (!game.home){ %> <%= data.team.abbr %> <% } else { %> <%= round.seriesOpponent.abbr %> <% } %></p>
                    </div>

                    <div class="gameTimeDiv">
                        <p>Game <%= game.gameNumOfSeries %></p>
                        <p>
                            <% if (game.status == "pre"){ %>
                                <%= game.startTime %>
                            <% } else if (game.status == "in"){ %>
                                In Progress
                            <% } else { %>
                                <% if (game.winner){ %>
                                    <strong class="winner">W</strong>
                                <% } else { %>
                                    <strong class="loser">L</strong>
                                <% } %>
                                <%= game.awayScore %> - <%= game.homeScore %>
                            <% } %>
                        </p>
                        <a href="http://localhost:<%= port %>/<%= sport %>/<%= league %>/games/<%= game.id %>">
                            Game Stats
                        </a>
                    </div>

                    <div class="homeTeamDiv">
                        <img class="teamLogo" src="<% if (game.home) { %> <%= data.team.logo %> <% } else { %> <%= round.seriesOpponent.logo %> <% } %>">
                        <p><% if (game.home){ %> <%= data.team.abbr %> <% } else { %> <%= round.seriesOpponent.abbr %> <% } %></p>
                    </div>
                    
                </div>

            <% }) %>

            <h2 class="seriesResult">

                <% if (round.homeWins > round.awayWins){ %>

                    <%= data.team.abbr %> <% if (round.homeWins < round.neededWins) { %> Leads 
                        <% } else { %> Wins Series <%= round.homeWins %>-<%= round.awayWins %> <% } %>

                <% } else if (round.homeWins < round.awayWins){ %>

                    <%= round.seriesOpponent.abbr %> <% if (round.awayWins < round.neededWins) { %> Leads 
                        <% } else { %> Wins Series <%= round.awayWins %>-<%= round.homeWins %> <% } %>

                <% } else { %>

                    Series tied <%= round.homeWins %>-<%= round.awayWins %>
                <% } %>
            </h2>
        </div>
    <% } %>
<% }) %>

<link rel="stylesheet" href="/styles/team_schedule_styles/postseason_styles.css">