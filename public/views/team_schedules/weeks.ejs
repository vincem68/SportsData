
<% data.games.forEach((game, index) => { %>

    <!--After making div, check to see if next week is equal to bye week and just create this div-->
    <% if (index + 1 == data.byeWeek) { %>

        <h1 class="week">Week <%= data.byeWeek %></h1>
        <div class="byeWeekDiv">
            <h2>Bye Week</h2>
        </div>

    <% } else { %>

        <h1 class="week"><%= game.week %></h1>

        <!--Each week has div, set class to home or away depending on if team plays home or away-->
        <div class="footballWeekDiv <% if (game.home){ %> homeGame <% } else { %> roadGame <% } %>">

            <!--Either @ or vs symbol depending on home/road game-->
            <img class="gameSymbol" src="<% if (game.home) { %> /images/versus_sign.png <% } else { %> /images/at_symbol.png <% } %>">

            <!--Div for opponent logo and name-->
            <div class="footballTitleDiv">
                <img class="footballOpponentLogo" src="<%= game.opponentLogo %>">
                <p class="footballTeamName"><%= game.opponent %></p>
            </div>

            <!--Short game details, display date if game has yet to happen, score and result if over, in progress else-->
            <p class="gameDetails">

                <% if (game.state == "pre"){ %>

                    <%= game.detail %>

                <% } else if (game.state == "post"){ %>
                    
                    <strong>
                        <% if (game.winner) { %>
                            W
                        <% } else { %>
                            L
                        <% } %>
                    </strong>

                    <%= game.score %>

                <% } else { %>
                    In Progress
                <% } %>
            </p>
        </div>
    <% } %>
<% }); %>

<link rel="stylesheet" href="/styles/team_schedule_styles/football_styles.css">