<!DOCTYPE html>

<html>
    <head>
        <title><%= league %> Stats</title>
        <link rel="stylesheet" href="/styles/league_stats.css">
    </head>

    <body>

        <%- include ('menu_header') %>

        <div class="topSection">
            <div class="titleSection">
                <% if (league == "MLB"){ %>
                    <img src = '/images/mlb_logo.png' class = 'mainLogo' alt = 'MLB Logo'>
                <% } else if (league == "NBA"){ %>
                    <img src = '/images/nba_logo.png' class = 'mainLogo' alt = 'NBA Logo'>
                <% } else if (league == "NFL"){ %>
                    <img src = '/images/nfl_logo.png' class = 'mainLogo' alt = 'NFL Logo'>
                <% } else { %>
                    <img src = '/images/nhl_logo.png' class = 'mainLogo' alt = 'NHL Logo'>
                <% } %>
                <h1><%= league %> Stats for the <%= leagueStats.requestedSeason.displayName 
                    + " " + leagueStats.requestedSeason.name  %></h1>
            </div>

            <div class="form-container">
                <form method="GET">

                    <div class="form-group">
                        <label for="season">Select Year</label>
                        <select name="season">
                            <% for (let i = leagueStats.season.year; i >= 2000; i--){ %>
                                <option value="<%= i %>"><%= i %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="seasonType">Select Season Type</label>
                        <select name="seasonType">
                            <option value="2">Regular Season</option>
                            <option value="3">Postseason</option>
                        </select>
                    </div>

                    <button>Submit</button>
                </form>
            </div>
        </div>

        <!--Lets do it so you can pick a category-->
        <% if (leagueStats.categories.length != 0){ %>
            <div class="select-wrapper">
                <label for="categorySelect">Select Category:</label>
                <select id="categorySelect" name="categorySelect"> <!--pick category-->
                    <% leagueStats.categories.forEach((category, index) => { %>
                        <option value="<%= index %>"><%= category.name %></option>
                    <% })%>
                </select>
            </div>
        <% } %>

        <!--If no stats are given-->
        <% if (leagueStats.categories.length == 0){ %>

            <h1>Data is Not Available</h1>

        <% } else { %> <!--else make the table-->

            <div id="statTables">

                <h4>Click on Column Names to Sort by a Stat. Green is Sorted by Most, Red by Least.</h4>
            
                <% leagueStats.categories.forEach(category => { %><!--loop through the category names and make table for each-->

                    <h3 class="importantHeadline"><%= category.name %></h3> <!--category name-->
                    
                    <div class="tableDiv">

                        <table>
                            <tr>
                                <th class="sticky">Rank</th>
                                <th class="sticky">Team</th> <!--Team column-->
                                <!--populate first row with the names of stats in current category-->
                                <% category.statsDesc.forEach((stat, index) => { %>
                                    <th class="statName" onclick="sortTable(<%= index %>)"> <!--give each column header an index name-->
                                        <div class="tooltip"><%= stat.abbreviation %>
                                            <span class="tooltip-text">
                                                <u><%= stat.name %></u>
                                                <br>
                                                <%= stat.description %>
                                            </span>
                                        </div>
                                    </th>
                                <% }) %>
                            </tr>
                            <!--go through each team in leagueStats and display their stats-->
                            <% category.teams.forEach((team, index) => { %>
                                <tr>
                                    <th class="sticky"><%= index + 1 %></th>
                                    <td class="sticky">
                                        <div class="teamDiv">
                                            <img class="teamLogo" src="<%= team.teamLogo %>">
                                            <%= team.teamAbbr %>
                                        </div>
                                    </td>
                                    <% team.statValues.forEach(value => { %>
                                        <td><%= value %></td>
                                    <% }) %>
                                </tr>
                            <% }) %>
                        </table>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <script>
            const leagueStats = <%- JSON.stringify(leagueStats) %>;
        </script>

        <script src="/scripts/league_stats.js"></script>

    </body>
</html>