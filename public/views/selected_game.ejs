<!DOCTYPE html>
<html>

    <head>
        <title><%= overview.name %></title>
        <link rel="stylesheet" href="/styles/selected_game.css">
    </head>

    <body>

        <%- include ('menu_header') %>

        <!-------------------------------GAME OVERVIEW SECTION---------------------------->

        <!--This section will be about the general info about the game. Score, team logos
            and names, and the clock/inning info. Add season series stuff here-->
        <div id="overview">

            <!--This section is for the away team, with logo, name and record-->
            <div class="teamOverview">
                <img class="teamLogo" src="<%= overview.awayTeam.logo %>">
                <h1><%= overview.awayTeam.name %></h1>
                <h3><%= overview.awayTeam.record %></h3>
            </div>

            <!--This is the middle section for clock/inning info-->
            <div id="gameInfoOverview"> <!--Put status of game here-->

                <div id="gameStatus">
                    <p id="score"><!--game score if in/post game-->
                        <% if (overview.status.state != "pre"){ %>
                            <%= overview.awayTeam.score %> - <%= overview.homeTeam.score %>
                        <% } %>
                    </p>
                    <p id="status"><%= overview.status.shortDetail %></p>
                </div>

                <p id="seriesStatus"> <!--series score if in postseason and not NFL-->
                    <% if (overview.seasonType == 3 && league != "NFL" && overview.status.state != "in"){ %>
                        <%= overview.seriesSummary %>
                    <% } %>
                </p>

                <p id="gameAction">
                    <% if (overview.situation){ %>
                        <%= overview.situation.play %>
                    <% } %>
                </p>

                <div id="footballInfo"> <!--have this dive for football specific info-->
                    <img id="footballPossessionArrow" src="/images/left_arrow.png">
                    <p id="footballMarker"><!--shows what down and yard marker football game is at-->
                        <% if (league == "NFL" && overview.situation !== undefined){ %>
                            <%= overview.situation.downDistanceText %>
                        <% } %>
                    </p>
                </div>

                <div id="atBat"> <!--for baseball, shows count, outs, and pitcher/batter-->
                    <div class="atBatPlayer">
                        <p>Pitcher</p>
                        <img id="pitcherHeadshot" src="<%= overview.situation && overview.situation.pitcher ? overview.situation.pitcher.headshot : '' %>">
                        <p id="pitcherName">
                            <% if (overview.situation && overview.situation.pitcher){ %>
                                <%= overview.situation.pitcher.name %>
                            <% } %>
                        </p>
                    </div>
                    <div id="baseballScorebug">
                        <img id="bases" src="">
                        <p id="count"><!--Keeps track of ball and strike count in baseball game-->
                            <% if (overview.situation && overview.situation.batter){ %>
                                <%= overview.situation.count %>
                            <% } %>
                        </p>
                        <img id="outs" src="">
                    </div>
                    <div class="atBatPlayer">
                        <p>Batter</p>
                        <img id="batterHeadshot" src="<%= overview.situation && overview.situation.batter ? overview.situation.batter.headshot : '' %>">
                        <p id="batterName">
                            <% if (overview.situation && overview.situation.batter){ %>
                                <%= overview.situation.batter.name %>
                            <% } %>
                        </p>
                    </div>
                </div>      
            </div>

            <!--home team overview, with name, logo and record-->
            <div class="teamOverview">
                <img class="teamLogo" src="<%= overview.homeTeam.logo %>">
                <h1><%= overview.homeTeam.name %></h1>
                <h3><%= overview.homeTeam.record %></h3>
            </div>
        </div>


        <!-------------------------PROBABLE STARTING PITCHERS --------------------------->
        <% if (overview.status.state == "pre" && league == "MLB"){ %>
            <div id="startingPitchersDiv">
                <h2>Probable Starting Pitchers</h2>
                <div>
                    <div class="SPDiv">
                        <img class="SPHeadshot" src="<%= overview.awayTeam.startingPitcher.headshot %>">
                        <p><%= overview.awayTeam.startingPitcher.name %></p>
                    </div>
                    <div class="SPDiv">
                        <img class="SPHeadshot" src="<%= overview.homeTeam.startingPitcher.headshot %>">
                        <p><%= overview.homeTeam.startingPitcher.name %></p>
                    </div>
                </div>
            </div>
        <% } %>

        
        <!---------------------------------LINESCORE------------------------------------->
        <!--(this shows the points for both teams in every quarter/period/inning)-->
        <div id="linescoreDiv">
            <h2>Linescores</h2>
            <table id="linescores">
                <tr id="linescoreHeaders">
                    <th>Team</th>
                    <% overview.linescore.intervals.forEach(interval => { %> 
                        <th class="linescoreInterval"><%= interval %></th> 
                    <% }) %>
                    <% if (league == "MLB"){ %> <th id="headerPoint">R</th> <th>H</th> <th>E</th> <% } %>
                </tr>
                <tr id="awayTeamLinescoreRow">
                    <th class="name"><%= overview.awayTeam.abbreviation %></th>
                    <% overview.linescore.awayLinescore.forEach(score => { %> <td class="linescoreCell"><%= score %></td> <% }) %>
                    <% if (league == "MLB"){ %>
                        <td id="awayPoint" class="mlbLinescores"><%= overview.linescore.awayRuns %></td>
                        <td class="mlbLinescores"><%= overview.linescore.awayHits %></td>
                        <td class="mlbLinescores"><%= overview.linescore.awayErrors %></td>
                    <% } %>
                </tr>
                <tr id="homeTeamLinescoreRow">
                    <th class="name"><%= overview.homeTeam.abbreviation %></th>
                    <% overview.linescore.homeLinescore.forEach(score => { %> <td><%= score %></td> <% }) %>
                    <% if (league == "MLB"){ %>
                        <td id="homePoint" class="mlbLinescores"><%= overview.linescore.homeRuns %></td>
                        <td class="mlbLinescores"><%= overview.linescore.homeHits %></td>
                        <td class="mlbLinescores"><%= overview.linescore.homeErrors %></td>
                    <% } %>
                </tr>
            </table>
        </div>


        <!---------------------------------BOX SCORE--------------------------------------->
        <!--This will display the overall team stats info-->
        <h3 id="boxHeadline"><% overview.status.state == "pre" ? "Season Stats" : "Box Score" %></h3>
        <div id="boxscore">
            <table>
                <% if (league != "MLB") { %>
                    <tr>
                        <th>Team</th>
                        <% summary.awayTeamStats.forEach(stat => { %> <th><%= stat.label %></th> <% }) %>
                    </tr>
                    <tr id="awayTeamBoxscore">
                        <th><%= summary.awayTeamAbbr %></th>
                        <% summary.awayTeamStats.forEach(stat => { %> <td><%= stat.value %></td> <% }) %>
                    </tr>
                    <tr id="homeTeamBoxscore">
                        <th><%= summary.homeTeamAbbr %></th>
                        <% summary.homeTeamStats.forEach(stat => { %> <td><%= stat.value %></td> <% }) %>
                    </tr>
                <% } %>
            </table>
        </div>


        <!-----------------------------LEADER SECTION------------------------------>

        <!--This will display the leaders of the game from both teams-->
        <div id="leaderSection">
            <h2 class="leaderHeadline"><%= summary.awayTeamAbbr %> Leaders</h2>
            <div id="awayTeamLeaders">
                <% if (summary.awayLeaders !== undefined){
                    summary.awayLeaders.forEach(leader => { %>
                        <div class="leaderDiv">
                            <h3><%= leader.category %></h3>    
                            <img class="headshot" src="<%= leader.athleteHeadshot %>">
                            <h4 class="leaderName"><%= leader.athleteName %></h5>
                            <p class="leaderDesc"><%= leader.value %></p>
                        </div>
                    <% })
                } %>
            </div>

            <h2 class="leaderHeadline"><%= summary.homeTeamAbbr %> Leaders</h2>
            <div id="homeTeamLeaders">
                <% if (summary.homeLeaders !== undefined){
                    summary.homeLeaders.forEach(leader => { %>
                        <div class="leaderDiv">
                            <h3><%= leader.category %></h3>
                            <img class="headshot" src="<%= leader.athleteHeadshot %>">
                            <h4 class="leaderName"><%= leader.athleteName %></h5>
                            <p class="leaderDesc"><%= leader.value %></p>
                        </div>
                    <% })
                } %>
            </div>
        </div>


        <!--------------------------------BUTTON SECTION----------------------------------->
        <!--This will be where we have two big divs that act as buttons. Clicking on them will show the player 
        stats for the corresponding team-->
        <div id="buttonSection">
            <div id="awayTeamButton"><%= overview.awayTeam.name %></div>
            <div id="homeTeamButton"><%= overview.homeTeam.name %></div>
        </div>


        <!--------------------------------PLAYER STATS SECTION------------------------------>
        <!--This will be where we have the tables for the player stats on both teams-->
        <div id="playerStats">

            <div id="awayTeamPlayerStats">
                <% if (summary.gameState != "pre"){ %>

                    <% summary.awayPlayerStats.forEach(cat => { %>
                        <div class="tableDiv">
                            <h2><%= cat.categoryName %></h2>
                            <table id="<%= cat.tableID %>"> <!--Every table will have ID matching category name-->
                                <tr id="awayColHeaders">
                                    <% if (cat.tableID.includes("batting")){ %> <th>Position</th> <% } %>
                                    <th>Player</th>
                                    <% cat.catLabelsAndDescs.forEach(info => { %>
                                        <th>
                                            <div class="tooltip">
                                                <%= info.label %>
                                                <span class="tooltip-text">
                                                    <%= info.desc %>
                                                </span>
                                            </div>
                                        </th>
                                    <% }) %>
                                </tr>
                                <% cat.players.forEach(player => { %>
                                    <tr class="<%= player.rowID %>">
                                        <% if (cat.categoryName == "BATTING"){ %>
                                            <td><% if (!player.starter) { %> * - <% } %> <%= player.position %></td>
                                        <% } %>
                                        <td class="name"><%= player.athleteName %></td>
                                        <% player.stats.forEach(stat => { %> <td class="stat"><%= stat %></td> <% }) %>
                                    </tr>
                                <% }) %>
                            </table>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <div id="homeTeamPlayerStats">
                <% if (summary.gameState != "pre"){ %>

                    <% summary.homePlayerStats.forEach(cat => { %>
                        <div class="tableDiv">
                            <h2><%= cat.categoryName %></h2>
                            <table id="<%= cat.tableID %>"> <!--Every table will have ID matching category name-->
                                <tr id="homeColHeaders">
                                    <% if (cat.tableID.includes("batting")){ %> <th>Position</th> <% } %>
                                    <th>Player</th>
                                    <% cat.catLabelsAndDescs.forEach(info => { %>
                                        <th>
                                            <div class="tooltip">
                                                <%= info.label %>
                                                <span class="tooltip-text">
                                                    <%= info.desc %>
                                                </span>
                                            </div>
                                        </th>
                                    <% }) %>
                                </tr>
                                <% cat.players.forEach(player => { %>
                                    <tr class="name <%= player.rowID %>">
                                        <% if (cat.categoryName == "BATTING"){ %>
                                            <td><% if (!player.starter) { %> * - <% } %> <%= player.position %></td>
                                        <% } %>
                                        <td class="name"><%= player.athleteName %></td>
                                        <% player.stats.forEach(stat => { %> <td class="stat"><%= stat %></td> <% }) %>
                                    </tr>
                                <% }) %>
                            </table>
                        </div>
                    <% }) %>
                <% } %>
            </div>

        </div>

        <!--declare variables from the rendered data here for the scripts-->
        <script>
            const summary = <%- JSON.stringify(summary) %>;
            const overview = <%- JSON.stringify(overview) %>;
            const summaryEndpoint = "<%= summary.endpoint %>";
            const overviewEndpoint = "<%= overview.endpoint %>";
            const gameState = "<%= summary.gameState %>";
            const league = "<%= league %>";
        </script>

        <script type="module" src="/scripts/selected_game.js"></script>

    </body>
</html>