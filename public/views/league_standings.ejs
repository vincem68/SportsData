<!DOCTYPE html>

<html>
    <head>
        <title><%= league %> Standings</title>
        <link rel="stylesheet" href="/styles/league_standings.css">
    </head>

    <body>

        <%- include ('menu_header') %>

        <div id="titleSection">
            <% if (league == "MLB"){ %>
                <img src = '/images/mlb_logo.png' id='mainLogo' alt = 'MLB Logo'>
            <% } else if (league == "NBA"){ %>
                <img src = '/images/nba_logo.png' id='mainLogo' alt = 'NBA Logo'>
            <% } else if (league == "NFL"){ %>
                <img src = '/images/nfl_logo.png' id='mainLogo' alt = 'NFL Logo'>
            <% } else { %>
                <img src = '/images/nhl_logo.png' id='mainLogo' alt = 'NHL Logo'>
            <% } %>
            <h1><%= league %> Standings</h1>
        </div>

        <% if (firstConferenceStandings.divisions.length == 0){ %>
            <h2 class="errorMessage">No standings data available at this time.</h2>    
        <% } else { %>

           
            <div id="standingsDiv">

                <div id="divisionStandingsContainer">

                    <% firstConferenceStandings.divisions.forEach(division => { %>

                        <div>
                            
                        </div>

                    <% }) %>


                    <div id="conferenceStandingsContainer">

                        <div class="conferenceStandings">
                            <% firstConferenceStandings.forEach(team => )
                        </div>

                        <div class="conferenceStandings">
                            
                        </div>
                    </div>


                </div>
            </div>
        <% } %>
    </body>

</html>