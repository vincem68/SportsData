<!DOCTYPE html>

<html>
    <head>
        <title><%= league %> Standings</title>
        <link rel="stylesheet" href="/styles/league_standings.css">
    </head>

    <body>

        <%- include ('menu_header') %>

        <div class="topSection">

            <div id="titleSection">
                <% if (league == "MLB"){ %>
                    <img src = '/images/mlb_logo.png' id='mainLogo' alt = 'MLB Logo'>
                <% } else if (league == "NBA"){ %>
                    <img src = '/images/nba_logo.png' id='mainLogo' alt = 'NBA Logo'>
                <% } else if (league == "NFL"){ %>
                    <img src = '/images/nfl_logo.png' id='mainLogo' alt = 'NFL Logo'>
                <% } else { %>
                    <img src = '/images/nhl_logo.png' id='mainLogo' alt = 'NHL Logo'>
                <% } %>
                <h1><%= league %> Standings</h1>
            </div>

            <div class="form-container">
                    <form method="GET">

                        <div class="form-group">
                            <label for="season">Select Year</label>
                            <select name="season">
                                <% for (let i = standings.maxSeason; i >= 2000; i--){ %>
                                    <option value="<%= i %>"><%= i %></option>
                                <% } %>
                            </select>
                        </div>

                        <button>Submit</button>
                    </form>
                </div>
            </div>
        </div>

        <% if (standings.firstConferenceDivisions[0].teams.length == 0){ %>
            <h2 class="errorMessage">No standings data available at this time.</h2>    
        <% } else { %>

           <!--overall container for the standings in general-->
            <div id="standingsDiv">

                <!--container for the divisions standings portion-->
                <div id="divisionStandingsContainer">

                    <div class="divisionByConferenceContainer">
                        <% standings.firstConferenceDivisions.forEach(division => { %>

                            <div class="divisionDiv">
                                <h4><%= division.name %></h4>
                                <table>
                                    <tr>
                                        <th>Team</th>
                                        <% division.teams[0].stats.forEach(stat => { %>
                                            <th>
                                                <div class="tooltip">
                                                    <%= stat.abbr %>
                                                    <span class="tooltip-text">
                                                        <%= stat.desc %>
                                                    </span>
                                                </div>
                                            </th>
                                        <% }) %>
                                    </tr>

                                    <% division.teams.forEach(team => { %>
                                        <tr>
                                            <td class="teamTD">
                                                <img class="teamLogo" src="<%= team.logo %>">
                                                <%= team.abbr %>
                                            </td>
                                            <% team.stats.forEach(stat => { %>
                                                <td><%= stat.value %></td>
                                            <% }) %>
                                        </tr>
                                    <% }) %>
                                </table>
                            </div>

                        <% }) %>
                    </div>

                    <div class="divisionByConferenceContainer">
                        <% standings.secondConferenceDivisions.forEach(division => { %>

                            <div class="divisionDiv">
                                <h4><%= division.name %></h4>
                                <table>
                                    <tr>
                                        <th>Team</th>
                                        <% division.teams[0].stats.forEach(stat => { %>
                                            <th>
                                                <div class="tooltip">
                                                    <%= stat.abbr %>
                                                    <span class="tooltip-text">
                                                        <%= stat.desc %>
                                                    </span>
                                                </div>
                                            </th>
                                        <% }) %>
                                    </tr>

                                    <% division.teams.forEach(team => { %>
                                        <tr>
                                            <td class="teamTD">
                                                <img class="teamLogo" src="<%= team.logo %>">
                                                <%= team.abbr %>
                                            </td>
                                            <% team.stats.forEach(stat => { %>
                                                <td><%= stat.value %></td>
                                            <% }) %>
                                        </tr>
                                    <% }) %>
                                </table>
                            </div>

                        <% }) %>
                    </div>

                </div>

                <!--This will be the container div for the overall conference standings-->
                <div id="conferenceStandingsContainer">

                </div>

            </div>
        <% } %>
    </body>

</html>