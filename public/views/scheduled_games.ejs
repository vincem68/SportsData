<%

    const postseasonGames = [{key: 1, value: "Wild Card"}, {key: 2, value: "Divisional"},
        {key: 3, value: "Conference"}, {key: 5, value: "Super Bowl"}];
%> 

<!DOCTYPE html>
<html>

<head>
    <title><%= league %> Games</title>
    <link rel="stylesheet" href="/styles/league_schedule.css">
</head>

<body>

    <%- include ('menu_header') %>

    <div class="topSection">
        
        <div class="titleSection">
            <% if (league == "MLB"){ %>
                <img src = '/images/mlb_logo.png' class='mainLogo' alt = 'MLB Logo'>
            <% } else if (league == "NBA"){ %>
                <img src = '/images/nba_logo.png' class='mainLogo' alt = 'NBA Logo'>
            <% } else if (league == "NFL"){ %>
                <img src = '/images/nfl_logo.png' class='mainLogo' alt = 'NFL Logo'>
            <% } else { %>
                <img src = '/images/nhl_logo.png' class='mainLogo' alt = 'NHL Logo'>
            <% } %>
            <h1><%= league %> Scheduled Games</h1>
        </div>

        <% if (league == "NFL"){ %>

            <!--This will be what we select for the week, will show all games for the week-->
            <div class="form-container">
                <form method="GET">

                    <div class="form-group">
                        <label for="season">Select Season:</label>
                        <select name="season">
                            <% for (let i = leagueSchedule.season; i >= 2000; i--){ %>
                                <option value="<%= i %>"><%= i %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="seasonType">Select Season Type:</label>
                        <select id="typeSelector" name="seasonType">
                            <option value="2">Regular Season</option>
                            <option value="3">Postseason</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="week">Select Week:</label>
                        <select id="weekSelector" name="week"></select>
                    </div>

                    <button>Submit</button>
                </form>
            </div>

        <% } else { %>

            <div class="date-wrapper">
                <label for="dateSelection">Select A Date:</label>
                <form id="dateSelection" method="GET">
                    <input id="date" name="date" type="date" max="<%= leagueSchedule.seasonEndDate %>">
                    <button type="submit">Submit</button>
                </form>
            </div>
        <% } %>
    </div>

    <!--Show No Games Scheduled Statement if our lists are empty-->
    <% if (leagueSchedule.totalGames == 0){ %>
        
        <h1 id="noGamesWarning">No Games Scheduled</h1>

    <% } else { %>
        <h2 id="dateHeader">
            <% if (league == "NFL") { %>
                <% if (leagueSchedule.seasonType == 3){ %>
                    <%= postseasonGames.find(round => round.key == leagueSchedule.week).value %>
                <% } else { %>
                    <%= "Week " + leagueSchedule.week %>
                <% } %>
            <% } else { %>
                <%= leagueSchedule.seasonTypeName %>
            <% } %>
        </h2>
    <% } %>


    <!--Go through each list from rendered data, which are active, upcoming and completed games-->
    <% Object.values(leagueSchedule.schedule).forEach(gameList => { %>

        <h3 class="importantHeadline"><%= gameList.name %></h3>
        <div id="<%= gameList.id %>" class="gamesLayout">

            <% gameList.games.forEach(game => { %>

                <div id="<%= game.id %>" class="gameContainer">

                    <div class="awayTeamDiv">
                        <img class="teamLogo" src="<%= game.awayTeam.logo %>">
                        <p><%= game.awayTeam.abbreviation %></p>
                    </div>

                    <div class="gameTimeDiv">

                        <p class="status"><%= game.status.shortDetail %></p>

                        <p class="score">
                            <% if (game.status.state != "pre"){ %>
                                <%= game.awayTeam.score %> - <%= game.homeTeam.score %>
                            <% } %>
                        </p>

                        <p class="mlbCount">
                            <% if (league == "MLB" && game.situation !== undefined){ %>
                                <%= game.situation.count %>
                            <% } %>
                        </p>
                        <p class="mlbOuts">
                            <% if (league == "MLB" && game.situation !== undefined){ %>
                                <%= game.situation.outs %> Outs
                            <% } %> 
                        </p>

                        <img class="arrow_img" src="/images/left_arrow.png">

                        <p class="yardMarker">
                            <% if (league == "NFL" && game.situation !== undefined){ %>
                                <%= game.situation.downDistanceText %>
                            <% } %>
                        </p>

                        <p class="seriesRecord" style="display:none">
                            <!--If its the postseason and its not football-->
                            <% if (leagueSchedule.season.type == 3 && league != "NFL"){ %>
                                <%= game.seriesSummary %>
                            <% } %>
                        </p>

                        <!--game link-->
                        <a href="http://localhost:<%= port %>/<%= sport %>/<%= league.toLowerCase() %>/games/<%= game.id %>">
                            Game Stats
                        </a>
                    </div>

                    <div class="homeTeamDiv">
                        <img class="teamLogo" src="<%= game.homeTeam.logo %>">
                        <p><%= game.homeTeam.abbreviation %></p>
                    </div>
                </div>
            <% }) %>
        </div>
    <% }) %>

    <!--This section will display any teams on a bye week at the requested week-->
    <% if (league == "NFL" && leagueSchedule.week.teamsOnBye !== undefined){ %>
        <h3 id="byeWeekHeadline" class="importantHeadline">Teams on Bye Week</h3>
        <div id="byeWeekSection">
            <% leagueSchedule.week.teamsOnBye.forEach(team => { %>
                <div class="byeTeamsDiv">
                    <img class="teamLogo" src="<%= team.logo %>">
                    <p><%= team.abbreviation %></p>
                </div>
            <% }) %>
        </div>
    <% } %>

    <script>
        const leagueSchedule = <%- JSON.stringify(leagueSchedule) %>;
        const endpoint = leagueSchedule.endpoint;
        const league = "<%= league %>";
    </script>

    <script type="module" src="/scripts/scheduled_games.js"></script>

</body>
</html>