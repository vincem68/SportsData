<html>
    <head>
        <title><%= league %> Leaders</title>
        <link rel="stylesheet" href="/styles/league_leaders.css">
    </head>

    <body>

        <%- include ('menu_header') %>

        <div class="topSection">
            <div class="titleSection">
                <% if (league == "MLB"){ %>
                    <img src = '/images/mlb_logo.png' class= 'mainLogo' alt = 'MLB Logo'>
                <% } else if (league == "NBA"){ %>
                    <img src = '/images/nba_logo.png' class= 'mainLogo' alt = 'NBA Logo'>
                <% } else if (league == "NFL"){ %>
                    <img src = '/images/nfl_logo.png' class= 'mainLogo' alt = 'NFL Logo'>
                <% } else { %>
                    <img src = '/images/nhl_logo.png' class= 'mainLogo' alt = 'NHL Logo'>
                <% } %>
                <h1><%= league %> Stat Leaders for <%= reqYear + " " + reqSeasonName %></h1>
            </div>

            <div class="form-container">
                <form method="GET">
                    <div class="form-group">
                        <label for="season">Select Year</label>
                        <select name="season">
                            <% for (let i = currentYear; i >= 2000; i--){ %>
                                <option value="<%= i %>"><%= i %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="seasonType">Select Season Type:</label>
                        <select name="seasonType">
                            <option value="2">Regular Season</option>
                            <option value="3">Postseason</option>
                        </select>
                    </div>
                    <button>Submit</button>
                </form>
            </div>
        </div>

        <% if (data.categories === undefined){ %>

            <h1>Data is Not Available</h1>

        <% } else { %>

            <div class="select-wrapper">
                <select id="catSelect">
                    <% data.categories.forEach(cat => { %>
                        <option value="<%= cat.id %>"><%= cat.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <% data.categories.forEach(cat => { %>

                <div id="<%= cat.id %>" class="catDiv">
                    <h2 class="categoryHeadline"><%= cat.name %></h2>
                    <table>
                        <tr>
                            <th>Rank</th>
                            <th>Player</th>
                            <th>Current Team</th>
                            <th>Total</th>
                            <th>More Stats</th>
                        </tr>
                        <% cat.leaders.forEach(leader => { %>
                            <tr id="<%= cat.id %>-row-<%= leader.playerID %>">
                                <td><%= leader.rank %></td>
                                <td class="playerName"></td>
                                <td class="playerTeamLogo"></td>
                                <td><%= leader.value %></td>
                                <td class="playerLink"></td>
                            </tr>
                        <% }) %>
                        
                    </table>
                </div>
            <% }) %>
        <% } %>
    </body>

    <script>
        //all div elements for tables
        const catSelect = document.getElementById("catSelect");
        const catDivs = document.querySelectorAll(".catDiv");

        const leaderData = <%- JSON.stringify(data) %>;
        const sport = "<%= sport %>";
        const league = "<%= league %>";

        //since the JSON data doesn't contain needed info, send requests to fill up names, teams and link tds
        async function getAthletes(){
            //hide all the divs when we make a change
            catDivs.forEach(div => div.style.display = "none");
            //get the div element
            const div = document.getElementById(catSelect.value);
            //check to see if names are already filled, if not continue with function
            if (!div.classList.contains("dataFilled")){
                //get the leaders array of the selected category
                leaderData.categories.find(cat => cat.id === catSelect.value).leaders.forEach(async leader => {
                    const athlete = await (await fetch(leader.athleteEndpoint)).json();
                    const team = await (await fetch(leader.teamEndpoint)).json();
                    //fill in the name, team logo and link tds for the current leader
                    const row = document.getElementById(`${catSelect.value}-row-${leader.playerID}`);
                    row.querySelector(".playerName").innerHTML = `<img class="headshot" src="${athlete.headshot.href}">` + athlete.displayName;;
                    row.querySelector(".playerTeamLogo").innerHTML = `<img class="teamLogo" src="${team.logos[0].href}">${team.abbreviation}`;
                    row.querySelector(".playerLink").innerHTML = `<a href="http://localhost:<%= port %>/${sport}/${league}/player/${leader.playerID}">Player Stats</a>`;
                });
                //add class to show that we've filled in the data for this category, so we don't have to send requests again
                div.classList.add("dataFilled");
            }
            //display the div after filling in the data
            document.getElementById(catSelect.value).style.display = "flex";
        }

        //event listener for drowpdown, switches table display
        catSelect.addEventListener("change", getAthletes);
        // Initialize - hide all except first
        getAthletes(); //send request to data before displaying

    </script>

</html>