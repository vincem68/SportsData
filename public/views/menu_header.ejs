<link rel="stylesheet" href="/styles/general_styles/menu_header.css">
<div id="headerArea">

    <div class="leagueDropDown">
        <a href="/">
            <img id="home" src="/images/home_icon.png">
        </a>
    </div>

    <% const params = [
        ['football', 'nfl'],
        ['basketball', 'nba'],
        ['baseball', 'mlb'],
        ['hockey', 'nhl']
    ]; %>

    <% params.forEach((pair, index) => { %>

        <div class="leagueDropDown" onclick="showDropDown(<%= index %>)">

            <div class="display">
                <img class="leagueLogo" src="/images/<%= pair[1] %>_logo.png">
                <h1><%= pair[1].toUpperCase() %></h1>
            </div>
            
            <div class="list">
                <a href="http://localhost:<%= port %>/<%= pair[0] %>/<%= pair[1] %>/teams"><%= pair[1].toUpperCase() %> Teams</a>
                <a href="http://localhost:<%= port %>/<%= pair[0] %>/<%= pair[1] %>/news"><%= pair[1].toUpperCase() %> News</a>
                <a href="http://localhost:<%= port %>/<%= pair[0] %>/<%= pair[1] %>/stats"><%= pair[1].toUpperCase() %> Stats</a>
                <a href="http://localhost:<%= port %>/<%= pair[0] %>/<%= pair[1] %>/leaders"><%= pair[1].toUpperCase() %> Leaders</a>
                <a href="http://localhost:<%= port %>/<%= pair[0] %>/<%= pair[1] %>/standings"><%= pair[1].toUpperCase() %> Standings</a>
                <a href="http://localhost:<%= port %>/<%= pair[0] %>/<%= pair[1] %>/games"><%= pair[1].toUpperCase() %> Schedule</a>
            </div>
        </div>
    <% }) %>

</div>

<script>

    function showDropDown(index){
        const subMenus = document.querySelectorAll(".list");
        subMenus.forEach(subMenu => { subMenu.style.display = 'none'; });
        subMenus[index].style.display = 'block';
    }

    window.addEventListener('click', function (e) {
        if (!e.target.closest('.leagueDropDown')) {
            document.querySelectorAll('.list').forEach(d => d.style.display = 'none');
        }
    });
</script>