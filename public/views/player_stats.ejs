<!DOCTYPE html>

<html>
    <head>
        <title><%= playerInfo.playerName %> Stats</title>
        <link rel="stylesheet" href="/styles/player_stats.css">
    </head>

    <body>

        <%- include ('menu_header') %>

        <!--This is the basic info section of the player-->
        <div id="playerInfoDiv">

            <div id="playerTitleDiv">
                <% const playerHeadshot = (playerInfo.playerHeadshot !== "") ? playerInfo.playerHeadshot : "/images/default_headshot.png"; %>
                <img id="headshot" src="<%= playerHeadshot %>"> <!--player pic-->
                <h1><%= playerInfo.playerName %></h1> <!--player name-->
            </div>
            <!--when the player headshot is not in response-->
            <div id="secondaryInfoDiv">
                <h4>
                    <div id="extraPlayerInfo">
                        <img id="teamLogo" src="<%= playerInfo.teamLogo %>">
                        <h2><%= playerInfo.teamName %></h2>
                    </div>
                    <br>
                    Position: <%= playerInfo.playerPosition %><br>
                    Jersey No.: <%= playerInfo.playerJersey %><br>
                    Date of Birth: <%= playerInfo.playerDOB %> (Age: <%= playerInfo.playerAge %>)<br>
                    Draft Selection: <%= playerInfo.playerDraft %><br>
                    Experience: <%= playerInfo.playerExp %><br>
                    Height: <%= playerInfo.playerHeight %><br>
                    Weight: <%= playerInfo.playerWeight %><br>
                    <% if (playerInfo.playerShoots){ %>
                        Shoots: <%= playerInfo.playerShoots %><br>
                    <% } %>
                    <% if (playerInfo.playerBatsThrows){ %>
                        B/T: <%= playerInfo.playerBatsThrows %><br>
                    <% } %>
                </h4>
            </div>

            <div class="form-container">
                <form method="GET">

                    <div class="form-group">
                        <label for="season">Select Year</label>
                        <select name="season">
                            <% for (let i = playerInfo.currentSeason; i >= playerInfo.debutYear; i--){ %>
                                <option value="<%= i %>"><%= i %></option>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="seasonType">Select Season Type</label>
                        <select name="seasonType">
                            <option value="2">Regular Season</option>
                            <option value="3">Postseason</option>
                        </select>
                    </div>

                    <button>Submit</button>
                </form>
            </div>
        </div>

        <!--If the response returned null for the main stats, we have no stats to show for this player-->
        <% if (!playerOverview.categories){ %>

            <h1 class="errorMessage">No Player Data Available</h1>

        <!--Else, show the stats if we do have them-->
        <% } else { %>

            <!--This is the overall stats section of the player-->
            <h3 class="importantHeadline">Stats for <%= playerOverview.requestedSeason %> 
                <%= playerOverview.requestedSeasonType %> Season</h3>

            <div id="mainStats">

                <div class="select-wrapper">

                    <!--This will be for selecting the split category-->
                    <label for="splitSelect">Select a Category</label>
                    <select id="splitSelect" name="splitSelect">

                        <!--use the category index and name for each option-->
                        <% playerOverview.categories.forEach((cat, index) => { %>
                            <option value="<%= index %>"><%= cat.name %></option>
                        <% }) %>

                    </select>
                </div>

                <% playerOverview.categories.forEach(cat => { %>

                    <div class="splitsTableDiv">
                        <h2><%= cat.name %></h2>
                        <div>
                            <table>
                                <tr>
                                    <% cat.stats.forEach(stat => { %>
                                        <th>
                                            <div class="tooltip"><%= stat.abbr %>
                                                <span class="tooltip-text">
                                                    <u><%= stat.name %></u>
                                                    <br>
                                                    <%= stat.desc %> 
                                                </span>
                                            </div>
                                        </th>
                                    <% }) %>
                                </tr>
                                <tr>
                                    <% cat.stats.forEach(stat => { %>
                                        <td><%= stat.value %></td>
                                    <% }) %>
                                </tr>
                            </table>
                        </div>
                    </div>
                <% }) %>
            </div>

            <% if (playerSplits.categories.length === 0){ %>
                <h1 class="errorMessage">Advanced Split Data is Not Available</h1>
            <% } else { %>

                <!--For the advanced splits section-->
                <div id="advancedStatsSection">

                    <!--Show the advanced split stats here-->
                    <h3 class="importantHeadline">Advanced Splits For Current Season Only</h3>

                    <div class="select-wrapper">

                        <!--This will be for selecting the split category-->
                        <label for="advancedCatSelect">Select a Category</label>
                        <select id="advancedCatSelect" name="advancedCatSelect">

                            <!--use the category index and name for each option-->
                            <% playerSplits.categories.forEach(category => { %>
                                <option value="<%= category.index %>"><%= category.name %></option>
                            <% }) %>

                        </select>

                        <!--For each category, list all the splits when that category is selected above-->
                        <label for="advancedSplitSelect">Select a Stat:</label>
                        <% playerSplits.categories.forEach(category => { %>

                            <select name="advancedSplitSelect" class="advancedSplitSelect">
                                <% category.splits.forEach(split => { %>
                                    <option value="<%= split.index %>"><%= split.name %></option>
                                <% }) %>
                            </select>

                        <% }) %>
                    </div>

                    <div id="advancedStatsTables">

                        <table id="advancedSplitsTable">
                            <tr>
                                <% playerSplits.statsDesc.forEach(stat => { %>
                                    <th>
                                        <div class="tooltip"><%= stat.label %>
                                            <span class="tooltip-text">
                                                <u><%= stat.name %></u>
                                                <br>
                                                <%= stat.description %>
                                            </span>
                                        </div>
                                    </th>
                                <% }) %>
                            </tr>
                            <tr>
                                <!--Upon initial page load, only show the first split stats of first category-->
                                <% playerSplits.categories[0].splits[0].values.forEach((stat, index) => { %>
                                    <td id="cell-<%= index %>"><%= stat %></td> 
                                <% }) %>
                            </tr>
                        </table>
                    </div>
                </div>

                <script>
                    //get the category selector, stat selectors, and advanced splits table
                    const splitsTables = document.querySelectorAll('.splitsTableDiv');
                    const splitSelect = document.getElementById('splitSelect');
                    const advancedCatSelector = document.getElementById('advancedCatSelect');
                    const advancedSplitSelectors = document.querySelectorAll('.advancedSplitSelect');
                    const advancedSplitsTable = document.getElementById('advancedSplitsTable');

                    //get the player splits data from the server
                    const playerSplits = <%- JSON.stringify(playerSplits) %>;

                    //The function to toggle the correct div for the regular splits. 
                    function toggleSplitsTable(){
                        splitsTables.forEach(table => table.style.display = 'none');
                        splitsTables[splitSelect.value].style.display = 'flex';
                    }

                    //make stat selects and tables appear
                    function toggleAdvancedCatSelect(){
                        const index = advancedCatSelector.value;
                        advancedSplitSelectors.forEach(select => select.style.display = 'none');
                        advancedSplitSelectors[index].style.display = 'inline';
                        getAdvancedSplits();
                    }

                    function getAdvancedSplits(){
                        //get the index of the selected category and stat
                        const catIndex = advancedCatSelector.value;
                        const splitIndex = advancedSplitSelectors[catIndex].value;
                        for (let i = 0; i < playerSplits.statsDesc.length; i++){
                            const cell = document.getElementById(`cell-${i}`);
                            cell.textContent = playerSplits.categories[catIndex].splits[splitIndex].values[i];
                        }
                    }

                    //run function to show the correct stat select and advanced splits table upon page load
                    toggleSplitsTable();
                    toggleAdvancedCatSelect();
                    getAdvancedSplits();

                    //add event listeners
                    splitSelect.addEventListener('change', toggleSplitsTable);

                    advancedCatSelector.addEventListener('change', toggleAdvancedCatSelect);
                    advancedSplitSelectors.forEach(selector => {
                        selector.addEventListener('change', getAdvancedSplits);
                    });

                </script>
            <% } %>

        <% } %>
    </body>
</html>