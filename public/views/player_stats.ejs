<!DOCTYPE html>

<html>
    <head>
        <title><%= playerInfo.playerName %> Stats</title>
        <link rel="stylesheet" href="/styles/player_stats.css">
    </head>

    <body>

        <%- include ('menu_header') %>

        <!--This is the basic info section of the player-->
        <div id="playerInfoDiv">

            <div id="playerTitleDiv">
                <% const playerHeadshot = (playerInfo.playerHeadshot !== "") ? playerInfo.playerHeadshot : "/images/default_headshot.png"; %>
                <img id="headshot" src="<%= playerHeadshot %>"> <!--player pic-->
                <h1><%= playerInfo.playerName %></h1> <!--player name-->
            </div>
            <!--when the player headshot is not in response-->
            <div id="secondaryInfoDiv">
                <div id="extraPlayerInfo">
                    <img id="teamLogo" src="<%= playerInfo.teamLogo %>">
                    <h2><%= playerInfo.teamName + " " + playerInfo.playerPosition %></h2>
                </div>
                <h4>
                    Jersey <%= playerInfo.playerJersey %><br>
                    Date of Birth: <%= playerInfo.playerDOB %> (Age: <%= playerInfo.playerAge %>)<br>
                    Height: <%= playerInfo.playerHeight %><br>
                    Weight: <%= playerInfo.playerWeight %>
                </h4>
            </div>
        </div>

        <!--If the response returned null for the main stats, we have no stats to show for this player-->
        <% if (playerOverview === null){ %>

            <h1 class="errorMessage">Data is Not Available</h1>

        <!--Else, show the stats if we do have them-->
        <% } else { %>

            <!--This is the overall stats section of the player-->
            <h3 class="importantHeadline">Overall Stats</h3>
            <div id="mainStats">

                <table>
                    <!--get col names and descriptions-->
                    <tr>
                        <th>Category</th>
                        <% playerOverview.statsDesc.forEach(stat => { %>
                            <th>
                                <div class="tooltip"><%= stat.label %>
                                    <span class="tooltip-text">
                                        <%= stat.name %>
                                    </span>
                                </div>
                            </th>
                        <% }) %>
                    </tr>

                    <!--Now do rows for reg season, postseason, and career-->
                    <% playerOverview.splits.forEach(split => { %>
                        <tr>
                            <th><%= split.name %></th>
                            <% split.values.forEach(stat => { %>
                                <td><%= stat %></td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </table>
            </div>

            <% if (playerSplits.categories.length === 0){ %>
                <h1 class="errorMessage">Advanced Split Data is Not Available</h1>
            <% } else { %>

                <!--For the advanced splits section-->
                <div id="advancedStatsSection">

                    <div class="select-wrapper">

                        <!--This will be for selecting the split category-->
                        <label for="catSelect">Select a Category</label>
                        <select id="catSelect" name="catSelect">

                            <!--use the category index and name for each option-->
                            <% playerSplits.categories.forEach(category => { %>
                                <option value="<%= category.index %>"><%= category.name %></option>
                            <% }) %>

                        </select>

                        <!--For each category, list all the splits when that category is selected above-->
                        <label for="splitSelect">Select a Stat:</label>
                        <% playerSplits.categories.forEach(category => { %>

                            <select name="splitSelect" class="splitSelect">
                                <% category.splits.forEach(split => { %>
                                    <option value="<%= split.index %>"><%= split.name %></option>
                                <% }) %>
                            </select>

                        <% }) %>
                    </div>

                    <!--Show the advanced split stats here-->
                    <h3 class="importantHeadline">Advanced Splits %></h3>
                    <div id="advancedStatsTables">

                        <table id="advancedSplitsTable">
                            <tr>
                                <% playerSplits.statsDesc.forEach(stat => { %>
                                    <th>
                                        <div class="tooltip"><%= stat.label %>
                                            <span class="tooltip-text">
                                                <u><%= stat.name %></u>
                                                <br>
                                                <%= stat.description %>
                                            </span>
                                        </div>
                                    </th>
                                <% }) %>
                            </tr>
                            <tr>
                                <!--Upon initial page load, only show the first split stats of first category-->
                                <% playerSplits.categories[0].splits[0].values.forEach((stat, index) => { %>
                                    <td id="cell-<%= index %>"><%= stat %></td> 
                                <% }) %>
                            </tr>
                        </table>
                    </div>
                </div>

                <script>
                    //get the category selector, stat selectors, and advanced splits table
                    const categorySelector = document.getElementById('catSelect');
                    const statSelectors = document.querySelectorAll('.splitSelect');
                    const advancedSplitsTable = document.getElementById('advancedSplitsTable');

                    //get the player splits data from the server
                    const playerSplits = <%- JSON.stringify(playerSplits) %>;

                    //make stat selects and tables appear
                    function toggleStatSelect(){
                        const index = categorySelector.value;
                        statSelectors.forEach(select => select.style.display = 'none');
                        statSelectors[index].style.display = 'inline';
                        getSplits();
                    }

                    function getSplits(){
                        //get the index of the selected category and stat
                        const catIndex = categorySelector.value;
                        const splitIndex = statSelectors[catIndex].value;
                        for (let i = 0; i < playerSplits.statsDesc.length; i++){
                            const cell = document.getElementById(`cell-${i}`);
                            cell.textContent = playerSplits.categories[catIndex].splits[splitIndex].values[i];
                        }
                    }

                    //run function to show the correct stat select and advanced splits table upon page load
                    toggleStatSelect();
                    getSplits();

                    //add event listeners
                    categorySelector.addEventListener('change', toggleStatSelect);
                    statSelectors.forEach(selector => {
                        selector.addEventListener('change', getSplits);
                    });

                </script>
            <% } %>

        <% } %>
    </body>
</html>